# Copie para .env e troque a senha antes de subir os containers.
# O arquivo .env é ignorado pelo Git e não deve ser versionado.
POSTGRES_USER=preenchimento
POSTGRES_PASSWORD=defina-uma-senha-local-forte
POSTGRES_DB=preenchimento

# Portas publicadas apenas em 127.0.0.1 no compose.
API_PORT=3000
FRONTEND_PORT=8080

# Origens permitidas pela API (separadas por vírgula, sem caminho).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

LOG_LEVEL=info

# Opcional apenas no ambiente local: chave para conceder 3 créditos fictícios.
# Gere com openssl rand -hex 32. Nunca habilite em produção.
# DEV_GRANT_SECRET=

# Opcional: modo QA local para usar fotos e textos SOMENTE fictícios e
# baixar PDFs de AMOSTRA com marca d'água. Não habilitar em produção.
DEV_QA_PREVIEW=false


# OCR: por padrão a aplicação detecta as CPUs disponíveis (inclusive limites
# de cgroup/Docker), reserva CPU para API/Postgres e dimensiona workers.
# Deixe "auto" até medir a VPS com documentos reais.
OCR_RESERVED_CPUS=auto
OCR_MAX_WORKERS=4
OCR_WORKERS=auto
OCR_CPU_THREADS=auto
OCR_QUEUE_DEPTH=auto
OCR_MAX_CONCURRENT=auto
