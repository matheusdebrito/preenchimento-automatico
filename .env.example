# Copie para .env e troque a senha antes de subir os containers.
# O arquivo .env é ignorado pelo Git e não deve ser versionado.
POSTGRES_USER=preenchimento
POSTGRES_PASSWORD=defina-uma-senha-local-forte
POSTGRES_DB=preenchimento

# Portas publicadas apenas em 127.0.0.1 no compose.
API_PORT=3000
FRONTEND_PORT=8080

# Origens permitidas pela API (separadas por vírgula, sem caminho).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

LOG_LEVEL=info

# E-mail de uma CONTA JA EXISTENTE que deve receber role ADMIN no boot da API.
# Fluxo seguro: crie a conta comum primeiro, depois configure este valor e reinicie a API.
# A senha continua no banco e nunca deve ir para o .env.
ADMIN_EMAIL=

# Opcional apenas no ambiente local: chave para conceder 3 créditos fictícios.
# Gere com openssl rand -hex 32. Nunca habilite em produção.
# DEV_GRANT_SECRET=

# OpenAI document understanding.
# A chave fica SOMENTE no backend/VPS. Nunca exponha OPENAI_API_KEY no frontend.
# Use o snapshot exato para facilitar custo, testes e elegibilidade de tokens promocionais.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Opcional quando a chave pode acessar mais de um projeto.
OPENAI_PROJECT_ID=
# Para documentos pequenos, high prioriza leitura de texto miúdo. Pode ser auto/low/high.
OPENAI_DOCUMENT_DETAIL=high
